##########################
######## BASE ESTUDIANTES ------
###########################
library(dplyr)
estudiantes <- read.csv("estudiantes.csv")
str(estudiantes)
View(estudiantes)
windows()
plot(estudiantes$Horas_Estudio, estudiantes$Promedio,
main = "Diagrama de Dispersión: Horas_De-Estudio vs Promedio",
xlab = "Horas de Estudio",
ylab = "Promedio",
pch = 19, col = "steelblue")
# Añadimos una línea de tendencia para ayudar a la interpretación visual
## Nota: considerar variable dependiente e independiente
# Dibuja encima de un lienzo abierto previamente con comandos como plot
# Dibuja kineas horizantals, verticales, lineas de regresión y lineas con Pendiente
# e Intercepto
abline(lm(Promedio ~ Horas_Estudio, data = estudiantes), col = "red", lwd = 4)
###################
print("Coeficiente de correlación de Pearson:")
# La función cor() sirve para calcular el coeficiente de correlación entre dos
# vectores numéricos o entre todas las columnas de una tabla de datos (matriz
# de correlación).
cor(estudiantes$Horas_Estudio, estudiantes$Promedio)
df_corr_est <- estudiantes %>%
select(Horas_Estudio, Promedio)
head(df_corr_est)
View(df_corr_est)
corr_est <- cor(df_corr_est)  # Obtenemos la matriz de correlación
corr_est
library(reshape2)
# melt()) sirve para transformar una tabla de formato ancho a formato largo
corr_melt <- melt(corr_est)
corr_melt
library(ggplot2)
windows()
ggplot(corr_melt, aes(Var1, Var2, fill=value)) +
geom_tile() +
scale_fill_gradient2() +
labs(title="Correlaciones estudiante Vs Horas de estudio")
######################
# La función cor.test() sirve para evaluar la significancia estadística de una
# correlación entre dos variables cuantitativas
test_correlacion <- cor.test(estudiantes$Horas_Estudio, estudiantes$Promedio)
print(test_correlacion)
###############################################################
modelo <- lm(Promedio ~ Horas_Estudio, data = estudiantes)
modelo
summary(modelo)
# crear una tabla de datos nueva (data.frame) de una sola fila y una sola columna.
# Define que la tabla tendrá una columna llamada Horas_Estudio y que en su
# primera fila guardará el valor numérico 2
nuevo_estudiante <- data.frame(Horas_Estudio = 2)
#La función predict() sirve para hacer predicciones automáticas utilizando un
# modelo estadístico o de machine learning que ya ha sido entrenado previamente
# (como una regresión lineal con lm(), una regresión logística con glm(), o
# modelos de árboles de decisión)
prediccion <- predict(modelo, nuevo_estudiante)
prediccion
