#### MACHINE LEARNING
### MODELADO PREDICTIVO CON MACHINE LEARNING
### DATA LIMPIA REPRODUCIBLE (OBLIGATORIO)
### (Ejecutar ANTES del ML)
library(dplyr)
library(tidyverse) # Para limpiar datos
#install.packages("caret")
library(caret)     # Para Machine Learning
url <- "https://raw.githubusercontent.com/rashida048/Datasets/master/StudentsPerformance.csv"
df <- read.csv(url)
df
View(df)
dim(df)
str(df)
###############################################
## Variable Original	Traducción       	 Tipo de Dato	 ¿Qué representa?
## gender	            Género	             Categórica	   Identifica si el estudiante es hombre o mujer (male / female).
## race/ethnicity     Grupo étnico	       Categórica	   Clasifica a los estudiantes en grupos anónimos (Group A, B, C, D, E).
## parental.loe     	Nivel edu padres	   Categórica	   El grado máximo de estudios de los padres (desde secundaria hasta maestría).
## lunch	            Almuerzo	           Categórica	   Indica si el alumno recibe almuerzo gratuito o reducido (free/reduced) o estándar (standard). Es un indicador del nivel socioeconómico.
## test prep course	  Curso preparación	   Categórica	   Indica si el alumno completó un curso de repaso antes del examen (none o completed).
##################################### Nuestra meta (Y), nota de matemáticas
## math score	        Nota Matemáticas	   Numérica	     Puntuación de 0 a 100 en el examen de matemáticas.
## reading score	    Nota Lectura	       Numérica	     Puntuación de 0 a 100 en el examen de lectura.
## writing score	    Nota Escritura	     Numérica      Puntuación de 0 a 100 en el examen de escritura.
###############################################
# ---------------------------------------------------------
# LIMPIEZA Y PREPARACIÓN (DATA WRANGLING) - RENOMBRAR LA DATA
# ---------------------------------------------------------
df <- df %>%
rename(
genero = gender,
grupo_etnico = race.ethnicity,
nivel_padres = parental.level.of.education,
almuerzo = lunch,
preparacion = test.preparation.course,
nota_mates = math.score,
nota_lectura = reading.score,
nota_escritura = writing.score
)
str(df)
dim(df)
# Convertimos columnas de texto a Factores (categorías)
df$genero <- as.factor(df$genero)
df$almuerzo <- as.factor(df$almuerzo)
df$preparacion <- as.factor(df$preparacion)
str(df)
dim(df)
# CREAMOS LA VARIABLE PARA LOGÍSTICA: "estatus_aprobado"
# Si saca más de 60 en matemáticas, está aprobado.
df <- df %>%
mutate(estatus_aprobado = ifelse(nota_mates >= 60, "Aprobado", "Reprobado"))
df$estatus_aprobado <- as.factor(df$estatus_aprobado)
df
str(df)
dim(df)
# ---------------------------------------------------------
# REGRESIÓN LINEAL (PREDICCIÓN NUMÉRICA)
# ---------------------------------------------------------
# Objetivo: Predecir la nota de matemáticas basada en lectura y escritura.
# Idea pedagógica(hipotesis): "¿Si eres bueno leyendo, serás bueno en matematicas?"
set.seed(789)
indice <- createDataPartition(df$nota_mates, p = 0.8, list = FALSE)
indice
dim(indice)
tren <- df[indice, ]
tren
dim(tren)
test <- df[-indice, ]
test
dim(test)
modelo_lineal <- lm(nota_mates ~ nota_lectura + nota_escritura, data = tren)
modelo_lineal
summary(modelo_lineal)
###################################################
# Le pedimos al modelo que haga prediga sobre TEST
predicciones <- predict(modelo_lineal, newdata = test)
predicciones
# función postResample para ver el R-cuadrado real en datos nuevos
resultados_finales <- postResample(predicciones, test$nota_mates)
resultados_finales
### Si el R-squared en el Test (test) es similar Entrenamiento (tren)
### somos capaces de predecir el futuro - ESTADISTICAMENTE HABLANDO
###################################################
# ---------------------------------------------------------
# REGRESIÓN LOGÍSTICA (CLASIFICACIÓN BINARIA)
# ---------------------------------------------------------
# Objetivo: Clasificar si el alumno aprueba (>=60)
### basado en su preparación y notas.
modelo_logistico <- train(estatus_aprobado ~ nota_lectura + preparacion,
data = tren,
method = "glm",
family = "binomial")
modelo_logistico
# Predicciones en el grupo de prueba
predicciones_log <- predict(modelo_logistico, test)
predicciones_log
print("--- MATRIZ DE CONFUSIÓN ---")
confusionMatrix(predicciones_log, test$estatus_aprobado)
###### PROBANDO LAS PREDICCIONES CON LOS DOS MODELOS LINEAL Y LOGISTICO
### Haciendo Pronósticos (Predicción con datos nuevos)
### Imagina que llega un alumno nuevo llamado "Juan". Juan no ha dado
### el examen de matemáticas, pero sabemos que sacó 85 en Lectura y 80
### en Escritura. ¿Cómo le iría?
# Creamos al "Alumno Nuevo" (Juan)
# Nota: Los nombres de las columnas deben ser idénticos a los del modelo
nuevo_alumno <- data.frame(
nota_lectura = 85,
nota_escritura = 80,
preparacion = "none",
genero = factor("male", levels = levels(df$genero))
)
# Pronóstico de Nota Exacta (Regresión Lineal)
pred_nota <- predict(modelo_lineal, nuevo_alumno)
pred_nota
print(paste("La nota estimada de matemáticas para Juan es:", round(pred_nota, 2)))
# Pronóstico de Aprobación (Regresión Logística)
pred_aprobado <- predict(modelo_logistico, nuevo_alumno)
pred_aprobado
print(paste("¿Juan aprobará el curso?:", pred_aprobado))
#########################################################
library(ggplot2)
windows()
ggplot(df, aes(x = nota_lectura, y = nota_mates)) +
geom_point(aes(color = genero), alpha = 0.4) + # Puntos reales (alumnos)
geom_smooth(method = "lm", color = "red", se = TRUE) + # La línea de ML
labs(title = "Machine Learning: Prediciendo Matemáticas",
subtitle = "La línea roja es el 'aprendizaje' del modelo lineal",
x = "Nota de Lectura",
y = "Nota de Matemáticas (Predicción)") +
theme_minimal()
### Resumen puntos en una tendencia
windows()
ggplot(tren, aes(x = nota_lectura, y = nota_mates)) +
geom_point(color = "blue", alpha = 0.3) + # Datos de entrenamiento
geom_smooth(method = "lm", color = "red") + # La "inteligencia" del modelo
labs(title = "Visualizando el Aprendizaje del Modelo",
subtitle = paste("R-Squared:", round(summary(modelo_lineal)$r.squared, 3)),
x = "Nota de Lectura", y = "Nota de Matemáticas") +
theme_minimal()
##############################################################
windows()
ggplot(test, aes(x = nota_lectura, y = nota_mates)) +
geom_point(color = "blue", alpha = 0.3) + # Datos de evaluación
geom_smooth(method = "lm", color = "red") + # La "inteligencia" del modelo
labs(title = "Visualizando LA evaluacion del Modelo",
subtitle = paste("R-Squared:", round(summary(modelo_lineal)$r.squared, 3)),
x = "Nota de Lectura", y = "Nota de Matemáticas") +
theme_minimal()
