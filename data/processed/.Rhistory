test_correlacion3
############### APLICANDO REGRESION LINEAL
datos$salario_actual <- as.numeric(datos$salario_actual)
datos$salario_inicial <- as.numeric(datos$salario_inicial)
datos$niv_estudio <- as.numeric(datos$niv_estudio)
datos$exp_previa <- as.numeric(datos$exp_previa)
###################
modelo1 <- lm(salario_actual ~ niv_estudio, data = datos)
modelo1
summary(modelo1)
###################
modelo2 <- lm(salario_actual ~ exp_previa, data = datos)
modelo2
summary(modelo2)
##################
modelo3 <- lm(salario_actual ~ salario_inicial, data = datos)
modelo3
summary(modelo3)
###################
modelo_completo <- lm(salario_actual ~ salario_inicial + niv_estudio + exp_previa, data = datos)
modelo_completo
summary(modelo_completo)
modelo_final <- lm(salario_actual ~ salario_inicial, data = datos)
modelo_final
windows()
plot(datos$salario_inicial, datos$salario_actual,
main = "Modelo de Predicción Final",
xlab = "Salario Inicial", ylab = "Salario Actual", pch = 16, col = "gray")
abline(modelo_final, col = "blue", lwd = 2)
nuevo_empleado <- data.frame(salario_inicial = 450)
prediccion <- predict(modelo_final, nuevo_empleado)
prediccion
print(paste("Para un salario inicial de 450, el modelo predice un actual de:", round(prediccion, 2)))
