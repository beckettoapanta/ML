modelo_logistico
# Predicciones en el grupo de prueba
predicciones_log <- predict(modelo_logistico, test)
predicciones_log
print("--- MATRIZ DE CONFUSIÓN ---")
confusionMatrix(predicciones_log, test$estatus_aprobado)
###### PROBANDO LAS PREDICCIONES CON LOS DOS MODELOS LINEAL Y LOGISTICO
### Haciendo Pronósticos (Predicción con datos nuevos)
### Imagina que llega un alumno nuevo llamado "Juan". Juan no ha dado
### el examen de matemáticas, pero sabemos que sacó 85 en Lectura y 80
### en Escritura. ¿Cómo le iría?
# Creamos al "Alumno Nuevo" (Juan)
# Nota: Los nombres de las columnas deben ser idénticos a los del modelo
nuevo_alumno <- data.frame(
nota_lectura = 85,
nota_escritura = 80,
preparacion = "none",
genero = factor("male", levels = levels(df$genero))
)
# Pronóstico de Nota Exacta (Regresión Lineal)
pred_nota <- predict(modelo_lineal, nuevo_alumno)
pred_nota
print(paste("La nota estimada de matemáticas para Juan es:", round(pred_nota, 2)))
# Pronóstico de Aprobación (Regresión Logística)
pred_aprobado <- predict(modelo_logistico, nuevo_alumno)
pred_aprobado
print(paste("¿Juan aprobará el curso?:", pred_aprobado))
